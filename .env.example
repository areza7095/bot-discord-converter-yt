DISCORD_TOKEN=your-token

# Umur maksimal file audio/sisa kerjaan (hari). Default 3; set 0 untuk mematikan fitur.
AUDIO_RETENTION_DAYS=3

# Opsional: path yt-dlp manual (override). Kosongin kalau mau pakai hasil "npm run setup"
# di bin/win (Windows), bin/linux (Linux), atau bin/mac (macOS); fallback ke "yt-dlp" dari PATH.
YTDLP_PATH=

# Opsional: yt-dlp dipaksa IPv4 (default) karena IPv6 yang rusak bikin proses diam sampai timeout.
# Isi 0 untuk mematikan paksaan IPv4.
# YTDLP_FORCE_IPV4=0
